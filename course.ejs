<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= course.title %></title><link rel="stylesheet" href="/static/style.css"></head><body><header><div class="nav"><a class="brand" href="/home"><img src="/static/assets/logo.png">FS Learning</a><form method="post" action="/logout"><button class="ghost">Logout</button></form></div></header><main class="shell"><a href="/home" class="back">← My Courses</a><h1><%= course.title %></h1><p class="muted"><%= course.description %></p><div class="lesson-list"><% lessons.forEach((l,i)=>{ %><a class="lesson-row" href="/lesson/<%= l.id %>"><span class="number"><%= i+1 %></span><span><b><%= l.title %></b><small><%= l.video_file ? "Video available" : "Video pending upload" %></small></span><span>›</span></a><% }) %></div></main></body></html>