<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FS Learning</title><link rel="stylesheet" href="/static/style.css"></head><body><header><div class="nav"><div class="brand"><img src="/static/assets/logo.png">FS Learning</div><div><span><%= user.name %></span><form class="inline" method="post" action="/logout"><button class="ghost">Logout</button></form></div></div></header><main class="shell"><div class="hero"><div><p class="eyebrow">MY LEARNING</p><h1>Welcome, <%= user.name %> 👋</h1><p class="muted">Continue your courses and access lesson resources.</p></div></div><div class="grid"><% courses.forEach(c=>{ %><a class="course-card" href="/course/<%= c.id %>"><div class="course-icon">▶</div><div><h2><%= c.title %></h2><p class="muted"><%= c.lesson_count %> lesson(s)</p></div></a><% }) %></div><% if(!courses.length){ %><div class="empty">No courses have been assigned to your account yet.</div><% } %></main></body></html>