<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FS Learning Login</title><link rel="stylesheet" href="/static/style.css"></head><body><main class="shell center"><div class="login-card"><img class="logo" src="/static/assets/logo.png"><h1>FS Learning</h1><p class="muted">Sign in to continue learning.</p><form method="post" action="/login"><label>User ID</label><input name="username" required autocomplete="username"><label>Password</label><input type="password" name="password" required autocomplete="current-password"><button class="primary">Login</button></form><% if(error){ %><p class="error"><%= error %></p><% } %><div class="hint">Demo user can be created from Admin Panel. Default admin: <b>admin</b> / <b>admin12345</b></div></div></main></body></html>