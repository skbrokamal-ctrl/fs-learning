<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= lesson.title %></title><link rel="stylesheet" href="/static/style.css"></head><body><header><div class="nav"><a class="brand" href="/home"><img src="/static/assets/logo.png">FS Learning</a><form method="post" action="/logout"><button class="ghost">Logout</button></form></div></header><main class="shell"><a class="back" href="/course/<%= lesson.course_id %>">← Back to course</a><h1><%= lesson.title %></h1><p class="muted"><%= lesson.description %></p><div class="video-box"><% if(lesson.video_file){ %><video controls playsinline preload="metadata" src="/video/<%= lesson.id %>"></video><% } else { %><div class="video-placeholder">Video will be available here after upload.</div><% } %></div><section class="panel"><h2>📁 Resources</h2><% if(resources.length){ resources.forEach(r=>{ %><div class="resource"><div><b><%= r.title %></b><small><%= r.original_name %></small></div><a class="secondary" href="/resource/<%= r.id %>">Download PDF</a></div><% }) } else { %><p class="muted">No resources added yet.</p><% } %></section><section class="panel"><h2>💬 Message / Report a Problem</h2><form method="post" action="/message"><input type="hidden" name="lesson_id" value="<%= lesson.id %>"><label>Subject</label><input name="subject" placeholder="Problem with this lesson" required><label>Message</label><textarea name="body" rows="5" placeholder="Tell the admin what went wrong..." required></textarea><button class="primary">Send Message</button></form></section></main></body></html>