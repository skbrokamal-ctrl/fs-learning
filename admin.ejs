<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FS Learning Admin</title><link rel="stylesheet" href="/static/style.css"></head><body><header><div class="nav"><a class="brand" href="/home"><img src="/static/assets/logo.png">FS Learning <span class="admin-badge">ADMIN</span></a><form method="post" action="/logout"><button class="ghost">Logout</button></form></div></header><main class="shell"><div class="hero"><div><p class="eyebrow">ADMIN PANEL</p><h1>Control Center</h1><p class="muted">Manage users, course access, videos, PDFs and support messages.</p></div></div><div class="admin-grid"><section class="panel"><h2>👥 Create User</h2><form method="post" action="/admin/user"><input name="name" placeholder="Full name" required><input name="username" placeholder="Login ID" required><input name="password" placeholder="Password" required><select name="role"><option value="user">User</option><option value="admin">Admin</option></select><button class="primary">Create User</button></form><h3>Users</h3><div class="table-wrap"><table><tr><th>ID</th><th>Name</th><th>Login</th><th>Role</th><th>Status</th><th></th></tr><% users.forEach(u=>{ %><tr><td><%= u.id %></td><td><%= u.name %></td><td><%= u.username %></td><td><%= u.role %></td><td><%= u.active ? "Active":"Disabled" %></td><td><% if(u.id!==user.id){ %><form method="post" action="/admin/user/<%=u.id%>/toggle"><button class="mini"><%=u.active?"Disable":"Enable"%></button></form><% } %></td></tr><% }) %></table></div></section><section class="panel"><h2>📚 Create Course</h2><form method="post" action="/admin/course"><input name="title" placeholder="Course title" required><textarea name="description" placeholder="Description"></textarea><button class="primary">Create Course</button></form><h3>Assign Course to User</h3><form method="post" action="/admin/enroll"><select name="user_id" required><% users.filter(u=>u.role==="user").forEach(u=>{ %><option value="<%=u.id%>"><%=u.name%> — <%=u.username%></option><% }) %></select><select name="course_id" required><% courses.forEach(c=>{ %><option value="<%=c.id%>"><%=c.title%></option><% }) %></select><button class="primary">Assign Access</button></form></section><section class="panel"><h2>🎥 Add Lesson + Video</h2><form method="post" action="/admin/lesson" enctype="multipart/form-data"><select name="course_id" required><% courses.forEach(c=>{ %><option value="<%=c.id%>"><%=c.title%></option><% }) %></select><input name="title" placeholder="Lesson title" required><textarea name="description" placeholder="Lesson description"></textarea><input type="file" name="video" accept="video/*"><button class="primary">Add Lesson</button></form><h3>Lessons</h3><% lessons.forEach(l=>{ %><div class="admin-row"><div><b><%=l.title%></b><small><%=l.course_title%> · <%=l.video_file?"Video uploaded":"No video"%></small></div><form method="post" action="/admin/lesson/<%=l.id%>/delete"><button class="danger">Delete</button></form></div><% }) %></section><section class="panel"><h2>📄 Add PDF Resource</h2><form method="post" action="/admin/resource" enctype="multipart/form-data"><select name="lesson_id" required><% lessons.forEach(l=>{ %><option value="<%=l.id%>"><%=l.title%></option><% }) %></select><input name="title" placeholder="Resource title" required><input type="file" name="pdf" accept="application/pdf" required><button class="primary">Upload PDF</button></form></section><section class="panel"><h2>💬 Messages</h2><% if(messages.length){ messages.forEach(m=>{ %><div class="message"><div class="message-head"><b><%=m.name%> (@<%=m.username%>)</b><span><%=m.status%></span></div><h3><%=m.subject%></h3><p><%=m.body%></p><% if(m.admin_reply){ %><div class="reply"><b>Admin reply:</b> <%=m.admin_reply%></div><% } %><% if(m.status==="open"){ %><form method="post" action="/admin/message/<%=m.id%>"><textarea name="reply" placeholder="Reply to user (optional)"></textarea><button class="primary">Close & Reply</button></form><% } %></div><% }) } else { %><p class="muted">No messages yet.</p><% } %></section></div></main></body></html>